<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Run with: mvn test -DsuiteXmlFile=testng-regression.xml
     The TestListener is registered by Surefire for every run mode, so it is not repeated here. -->
<suite name="OrangeHRM - Regression Suite" verbose="1">
    <test name="Regression tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.orangehrm.tests"/>
        </packages>
    </test>
</suite>
